// Schema Prisma pour PostgreSQL (Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  status          String   @default("draft") // "published" ou "draft"
  modules         Module[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("courses")
  @@index([status])
  @@index([slug])
  @@index([status, createdAt(sort: Desc)])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  quizzes     Quiz[]
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, slug])
  @@map("modules")
  @@index([courseId])
  @@index([courseId, order])
}

model Lesson {
  id                   String   @id @default(cuid())
  moduleId             String
  module               Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  slug                 String
  content              String   @default("")
  featuredImageUrl     String?
  videoUrl             String?
  videoPlaybackSeconds Int?
  pdfUrl               String?
  allowPreview         Boolean  @default(false)
  order                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([moduleId, slug])
  @@map("lessons")
  @@index([moduleId])
  @@index([moduleId, order])
}

model Quiz {
  id                String         @id @default(cuid())
  moduleId          String?
  module            Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title             String
  slug              String         @unique
  description       String?
  excerpt           String?
  metaTitle         String?
  metaDescription   String?
  duration          Int            @default(10)
  difficulty        String?
  passingGrade      Int            @default(70)
  randomizeOrder    Boolean        @default(false)
  maxQuestions      Int?
  featuredImage     String?
  featuredImageUrl  String?
  order             Int            @default(0)
  sourceQuizId      String?        @unique @map("source_quiz_id")
  sourceSyncedAt    DateTime?      @map("source_synced_at")
  sourcePayloadHash String?        @map("source_payload_hash")
  isEnabled         Boolean        @default(true) @map("is_enabled")
  lockLocalEdits    Boolean        @default(false) @map("lock_local_edits")
  questions         Question[]
  quizAttempts      QuizAttempt[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("quizzes")
  @@index([slug])
  @@index([moduleId])
  @@index([moduleId, createdAt(sort: Desc)])
  @@index([isEnabled])
}

model SyncLog {
  id           String   @id @default(cuid())
  sourceQuizId String   @map("source_quiz_id")
  localQuizId  String?  @map("local_quiz_id")
  action       String
  status       String
  details      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sync_logs")
  @@index([sourceQuizId, createdAt(sort: Desc)])
}

model Question {
  id               String   @id @default(cuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sourceQuestionId String?  @map("source_question_id")
  text             String
  type             String   @default("multiple_choice")
  points           Int      @default(1)
  explanation      String?
  timeLimit        Int?
  order            Int      @default(0)
  answers          Answer[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("questions")
  @@index([quizId])
  @@index([quizId, order])
  @@index([quizId, sourceQuestionId])
}

model Answer {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceAnswerId String?  @map("source_answer_id")
  text           String
  isCorrect      Boolean  @default(false)
  explanation    String?
  imageUrl       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("answers")
  @@index([questionId])
  @@index([questionId, order])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  quizAttempts QuizAttempt[]
  comments     Comment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
  @@index([email])
}

model Comment {
  id          String   @id @default(cuid())
  targetType  String
  targetSlug  String
  authorName  String
  authorEmail String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("comments")
  @@index([targetType, targetSlug])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  content         String    @default("")
  category        String    @default("")
  tags            String[]  @default([])
  ctaLink         String?
  ctaText         String?
  metaTitle       String?
  metaDescription String?
  status          String    @default("draft")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blog_posts")
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([status, createdAt(sort: Desc)])
}

model CustomPage {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  metaTitle       String?
  metaDescription String?
  html            String    @default("")
  css             String    @default("")
  status          String    @default("draft")
  noIndex         Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("custom_pages")
  @@index([slug])
  @@index([status])
  @@index([status, publishedAt])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  percentage     Int
  totalQuestions Int
  correctAnswers Int
  timeSpent      Int
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("quiz_attempts")
  @@index([userId])
  @@index([quizId])
  @@index([completedAt])
}
